# Required: create your own Fish Audio API key in the Fish Audio dashboard.
# Keep the real value in .env.local; never use a NEXT_PUBLIC_ prefix.
FISH_AUDIO_API_KEY=

# Created and saved by: node scripts/setup-fish-agent.mjs
FISH_AUDIO_AGENT_ID=

# Created and saved by: node scripts/setup-native-voice.mjs
FISH_AUDIO_NATIVE_AGENT_ID=
FISH_AUDIO_DRAMA_AGENT_ID=

# Optional: an existing Fish Audio voice you own or are authorised to use.
# Enables personal-voice playback in the Translate tab.
FISH_AUDIO_TRANSLATION_VOICE_ID=
